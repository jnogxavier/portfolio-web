---
import Placa from '../components/marcas/Tipografica.astro';
import Icone from '../components/Icone.astro';
import '../styles/tokens.css';
import '../styles/componentes.css';
import '../styles/fontes.css';

import { textos, type Idioma } from '../i18n';
import { contato } from '../data/contato';
interface Props { titulo: string; descricao: string; lang?: Idioma; parUrl?: string; imagem?: string; tipo?: 'website' | 'article'; manchete?: string; canais?: boolean; robots?: string }
const { titulo, descricao, lang = 'pt', parUrl, imagem = '/og.png', tipo = 'website', manchete = titulo, canais = true, robots } = Astro.props;
const rotulos = textos[lang];
const raiz = rotulos.raiz;
const aqui = Astro.url.pathname;
const alterna = parUrl ?? (lang === 'en' ? '/' : '/en/');
const nav = [
  { texto: rotulos.nav.sobre, href: raiz + '#sobre' },
  { texto: rotulos.nav.casos, href: raiz + '#casos' },
  { texto: rotulos.nav.exp, href: raiz + '#experiencia' },
  { texto: rotulos.nav.skills, href: raiz + '#skills' },
  { texto: rotulos.nav.contato, href: raiz + '#contato' },
];
---
<!doctype html>
<html lang={rotulos.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F9F9F8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A1A1A" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" hreflang="pt-BR" href={new URL(lang === 'pt' ? aqui : alterna, Astro.site).href} />
    <link rel="alternate" hreflang="en" href={new URL(lang === 'en' ? aqui : alterna, Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(lang === 'pt' ? aqui : alterna, Astro.site).href} />
    <meta property="og:image" content={new URL(imagem, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={titulo} />
    <meta property="og:url" content={new URL(aqui, Astro.site).href} />
    <link rel="canonical" href={new URL(aqui, Astro.site).href} />
    <meta property="og:locale" content={rotulos.lang} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content={tipo} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "João Vitor Nogueira Xavier",
      "alternateName": "jnogxavier",
      "jobTitle": ["DevOps Engineer", "Platform Engineer", "Desenvolvedor Full Stack"],
      "description": "Engenheiro de plataforma e desenvolvedor full stack em Goiânia, Brasil.",
      "email": `mailto:${contato.email}`,
      "address": { "@type": "PostalAddress", "addressLocality": "Goiânia", "addressRegion": "GO", "addressCountry": "BR" },
      "knowsAbout": ["DevOps", "Platform Engineering", "SRE", "Infraestrutura", "Kubernetes", "GitOps", "ArgoCD",
        "Terraform", "CI/CD", "Observabilidade", "OpenTelemetry", "Docker", "AWS", "Oracle Cloud",
        "Full Stack", "Ruby on Rails", "PostgreSQL", "React", "Flutter"],
      "knowsLanguage": ["pt-BR", "en"],
      "sameAs": [contato.github, contato.linkedin],
      "url": Astro.site?.href
    })} />
    {tipo === 'article' && <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": manchete,
      "description": descricao,
      "inLanguage": rotulos.lang,
      "image": new URL(imagem, Astro.site).href,
      "url": new URL(aqui, Astro.site).href,
      "author": { "@type": "Person", "name": "João Vitor Nogueira Xavier", "url": Astro.site?.href }
    })} />}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fontes/zilla-slab-700-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fontes/archivo-350_600-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fontes/jetbrains-mono-400_700-latin.woff2" />
    <script is:inline>
      (() => {
        const raiz = document.documentElement;
        const metas = document.querySelectorAll('meta[name="theme-color"]');
        const cores = {};
        let fim;
        metas.forEach((m) => { cores[/dark/.test(m.getAttribute('media')) ? 'dark' : 'light'] = m.content; });
        const escuro = () => raiz.dataset.tema ? raiz.dataset.tema === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        const marca = () => document.getElementById('tema')?.setAttribute('aria-pressed', String(escuro()));
        const aplica = (t) => {
          raiz.dataset.tema = t;
          metas.forEach((m) => { m.content = cores[t]; });
          marca();
        };
        document.addEventListener('DOMContentLoaded', marca);
        try {
          const t = localStorage.getItem('tema');
          if (t === 'dark' || t === 'light') aplica(t);
        } catch (e) {}
        document.addEventListener('click', (e) => {
          if (!e.target.closest('#tema')) return;
          const novo = escuro() ? 'light' : 'dark';
          raiz.dataset.trocando = '';
          aplica(novo);
          clearTimeout(fim);
          fim = setTimeout(() => delete raiz.dataset.trocando, 360);
          try { localStorage.setItem('tema', novo); } catch (e) {}
        });
      })();
    </script>
  </head>
  <body>
    <a class="pular" href="#conteudo">{rotulos.pular}</a>

    <header class="topo">
      <div class="tarja">
        <div class="faixa tarja__linha">
          <p class="estado">
            <span class="estado__no" aria-hidden="true"></span>
            <a href={`mailto:${contato.email}`} aria-label={rotulos.statusLabel}>{rotulos.status}</a>
            <span class="estado__onde">{rotulos.onde}</span>
          </p>
        </div>
      </div>

      <div class="faixa topo__linha">
        <a class="marca" href={raiz} aria-label={`jnogxavier, ${rotulos.inicio}`} aria-current={aqui === raiz ? 'page' : undefined}><Placa /></a>

        <nav class="menu" aria-label={rotulos.menu}>
          {nav.map((l) => (
            <a href={l.href} aria-current={aqui === l.href ? 'page' : undefined}>{l.texto}</a>
          ))}
        </nav>

        <div class="controles">
          <div class="idiomas" role="group" aria-label={rotulos.idioma}>
            {lang === 'pt'
              ? <span class="idioma--atual" aria-current="true" lang="pt">Português</span>
              : <a href={alterna} hreflang="pt-BR" lang="pt">Português</a>}
            {lang === 'en'
              ? <span class="idioma--atual" aria-current="true" lang="en">English</span>
              : <a href={alterna} hreflang="en" lang="en">English</a>}
          </div>
          <button class="tema" type="button" id="tema" aria-label={rotulos.alternarTema}>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="tema__sol">
              <circle cx="12" cy="12" r="4.4" />
              <path d="M12 2.6v2.2M12 19.2v2.2M4.4 12H2.2M21.8 12h-2.2M6.6 6.6 5 5M19 19l-1.6-1.6M17.4 6.6 19 5M5 19l1.6-1.6" />
            </svg>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="tema__lua">
              <path d="M20 14.2A8.4 8.4 0 0 1 9.8 4 8.4 8.4 0 1 0 20 14.2Z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="conteudo" tabindex="-1"><slot /></main>

    <footer class={canais ? 'rodape' : 'rodape rodape--colado'}>
      <div class="faixa rodape__linha">
        <p class="rodape__nome">João Vitor Nogueira Xavier<span>{rotulos.local}</span></p>
        {canais && (
          <nav class="rodape__links" aria-label={rotulos.rodape}>
            <a href={`mailto:${contato.email}`}><Icone nome="email" /><span translate="no">{contato.email}</span></a>
            <a href={contato.zap} target="_blank" rel="noopener noreferrer"><Icone nome="whatsapp" />WhatsApp<span class="sr"> {rotulos.novaAba}</span></a>
            <a href={contato.github} target="_blank" rel="me noopener noreferrer"><Icone nome="github" />GitHub<span class="sr"> {rotulos.novaAba}</span></a>
            <a href={contato.linkedin} target="_blank" rel="me noopener noreferrer"><Icone nome="linkedin" />LinkedIn<span class="sr"> {rotulos.novaAba}</span></a>
            <a href={rotulos.cvArquivo} download><Icone nome="download" />{rotulos.cvBaixar}</a>
            {lang === 'pt'
              ? <a href={alterna} hreflang="en" lang="en">English</a>
              : <a href={alterna} hreflang="pt-BR" lang="pt">Português</a>}
          </nav>
        )}
      </div>
    </footer>
  </body>
</html>

<style>
  :global(html) {
    margin: 0;
    -webkit-tap-highlight-color: transparent;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    scroll-padding-top: var(--space-4);
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
  :global(body) { margin: 0; }
  :global(section:target > .faixa > h2),
  :global(section:target > .faixa > .secao__cabeca > h2) {
    width: fit-content; max-width: 100%;
    animation: alvo 1600ms ease-out both;
  }
  @keyframes alvo {
    0%, 60% { box-shadow: inset 0 -0.42em 0 color-mix(in oklch, var(--brand) 22%, transparent); }
    100% { box-shadow: inset 0 -0.42em 0 transparent; }
  }
  :global(html[data-trocando] *) {
    transition: background-color 320ms ease, border-color 320ms ease,
                color 320ms ease, fill 320ms ease, stroke 320ms ease !important;
  }
  :global(body) {
    background: var(--surface); color: var(--ink);
    font: 400 1rem/1.625 var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
  .faixa, :global(.faixa) {
    max-width: 68rem; margin-inline: auto;
    padding-inline: max(var(--space-5), env(safe-area-inset-left), env(safe-area-inset-right));
  }

  .pular {
    position: absolute; left: var(--space-4); top: var(--space-4); z-index: 20;
    transform: translateY(-200%);
    background: var(--band); color: var(--band-ink);
    display: inline-flex; align-items: center; min-height: 44px;
    padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm);
    font: 500 1rem/1 var(--font-sans); text-decoration: none;
  }
  .pular:focus { transform: translateY(0); }
  :global(main:focus) { outline: none; }
  :global(main:focus-visible) { outline: 2px solid var(--focus); outline-offset: -2px; }

  .topo { border-bottom: 1px solid var(--line); background: var(--surface); z-index: 10; }
  @media (min-width: 56rem) {
    .topo { position: sticky; top: 0; }
    :global(html) { scroll-padding-top: 7.5rem; }
  }
  .tarja { border-bottom: 1px solid var(--line); background: var(--surface-raised); }
  .tarja__linha { display: flex; align-items: center; min-height: 44px; }
  .topo__linha {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-3) var(--space-5); min-height: 60px; flex-wrap: wrap;
  }
  .estado {
    margin: 0; display: flex; align-items: center; gap: var(--space-2); min-width: 0;
    font: 400 0.75rem/1 var(--font-mono); color: var(--ink);
  }
  .estado__no {
    width: 7px; height: 7px; border-radius: var(--radius-full);
    background: var(--healthy); flex: none; align-self: center;
  }
  .estado a { color: inherit; display: inline-flex; align-items: center; min-height: 44px; text-underline-offset: 3px; text-decoration-color: var(--line); }
  .estado a:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) { .estado a:hover { text-decoration-color: currentColor; } }
  .estado__onde { color: var(--ink-muted); white-space: nowrap; margin-left: var(--space-2); }

  .tema {
    display: grid; place-items: center; flex: none;
    width: 44px; height: 44px; padding: 0;
    background: none; border: 0; cursor: pointer; color: var(--ink-muted);
    transition: color 140ms ease, transform 140ms var(--ease-out);
  }
  .tema svg {
    grid-area: 1 / 1; width: 18px; height: 18px;
    fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round;
    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out);
  }
  .tema__lua { opacity: 0; transform: rotate(-90deg) scale(0.8); }
  :global(:root[data-tema='dark']) .tema__sol,
  :global(:root:not([data-tema='light'])) .tema__sol { opacity: 0; transform: rotate(90deg) scale(0.8); }
  :global(:root[data-tema='dark']) .tema__lua,
  :global(:root:not([data-tema='light'])) .tema__lua { opacity: 1; transform: none; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-tema='dark'])) .tema__sol { opacity: 1; transform: none; }
    :global(:root:not([data-tema='dark'])) .tema__lua { opacity: 0; transform: rotate(-90deg) scale(0.8); }
  }
  .tema:active { transform: scale(0.97); }
  .tema:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) { .tema:hover { color: var(--ink); } }
  @media (prefers-reduced-motion: reduce) { .tema svg { transition: opacity 160ms var(--ease-out); transform: none !important; } }

  @media (max-width: 30rem) { .estado__onde { display: none; } }
  .marca { color: var(--ink); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .marca { order: 1; }
  .menu { order: 2; margin-left: auto; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-5); min-width: 0; }
  .controles { order: 3; display: flex; align-items: center; gap: var(--space-5); flex: none; }
  .idiomas {
    display: inline-flex; align-items: center; flex: none; padding: 2px;
    border: 1px solid var(--line); border-radius: var(--radius-full);
  }
  .controles .idiomas > * {
    position: relative; isolation: isolate; display: inline-flex; align-items: center;
    height: 34px; padding: 0 var(--space-4); border-radius: var(--radius-full);
    font: 500 0.875rem/1 var(--font-sans); white-space: nowrap;
    color: var(--ink-muted); text-decoration: none;
    transition: color 140ms ease, transform 160ms var(--ease-out);
  }
  .controles .idiomas > *::after { content: ''; position: absolute; inset: -5px 0; }
  .controles .idiomas > .idioma--atual { background: var(--brand-ink); color: var(--surface); }
  .controles .idiomas > a::before {
    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit;
    background: color-mix(in oklch, var(--brand-ink) 14%, transparent);
    opacity: 0; transform: scale(0.9);
    transition: opacity 160ms var(--ease-out), transform 160ms var(--ease-out);
  }
  .controles .idiomas > a:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
  @media (max-width: 30rem) { .controles .idiomas > * { padding: 0 var(--space-3); } }
  @media (max-width: 30rem) { .topo__linha { column-gap: var(--space-2); } }
  @media (max-width: 24rem) {
    .controles .idiomas > * { padding: 0 var(--space-2); }
    .controles { gap: var(--space-2); }
    .menu { gap: var(--space-2) var(--space-3); }
    .menu a { font-size: 0.9375rem; }
  }
  @media (hover: hover) and (pointer: fine) {
    .controles .idiomas > a:hover { color: var(--ink); }
    .controles .idiomas > a:hover::before { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .controles .idiomas > a::before { transform: none; } }
  :global(a), :global(button) { touch-action: manipulation; }
  .menu a {
    font: 500 1rem/1 var(--font-sans); letter-spacing: 0.005em;
    color: var(--ink-muted); text-decoration: none; padding-block: 1.46875rem;
    transition: color 140ms ease, transform 160ms var(--ease-out);
  }
  @media (max-width: 56rem) {
    .menu { order: 3; flex-basis: 100%; margin-left: 0; gap: var(--space-2) var(--space-4); }
    .controles { order: 2; margin-left: auto; gap: var(--space-3); }
    .menu a { padding-block: 0.9375rem; }
    .topo__linha { padding-block: var(--space-2); }
  }
  @media (hover: hover) and (pointer: fine) { .menu a:hover { color: var(--ink); } }
  .menu a:active { transform: scale(0.97); }
  .menu a[aria-current='page'] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--brand); }
  .marca:focus-visible, .menu a:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }

  .rodape { position: relative; overflow: hidden; margin-top: var(--space-9); background: var(--band); color: var(--band-ink); }
  .rodape--colado { margin-top: 0; border-top: 1px solid color-mix(in oklch, var(--band-ink) 20%, var(--band)); }
  .rodape > * { position: relative; }
  .rodape__linha {
    display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6);
    justify-content: space-between; align-items: baseline;
    padding-block: var(--space-5) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
    font: 400 1rem/1.5 var(--font-sans);
  }
  .rodape__nome { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); }
  .rodape__nome span { opacity: 0.75; }
  .rodape__links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  .rodape__links a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; overflow-wrap: anywhere; transition: transform 160ms var(--ease-out); }
  .rodape a { color: inherit; text-underline-offset: 3px; text-decoration-color: color-mix(in oklch, currentColor 45%, transparent); }
  @media (hover: hover) and (pointer: fine) { .rodape a:hover { text-decoration-color: currentColor; } }
  @media (hover: hover) and (pointer: fine) { .rodape a:hover { text-decoration-thickness: 2px; } }
  .rodape a:focus-visible { outline: 2px solid var(--band-ink); outline-offset: 3px; }
  .rodape__links a:active { transform: scale(0.97); }
</style>
