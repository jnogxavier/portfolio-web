---
import { getCollection } from 'astro:content';
import Placa from '../components/marcas/Tipografica.astro';
import Icone from '../components/Icone.astro';
import '../styles/tokens.css';
import '../styles/componentes.css';
import '../styles/fontes.css';

import { textos, type Idioma } from '../i18n';
interface Props { titulo: string; descricao: string; atual?: string; lang?: Idioma; parUrl?: string }
const { titulo, descricao, atual, lang = 'pt', parUrl } = Astro.props;
const x = textos[lang];
const outro = textos[x.outro];
const raiz = x.raiz;
const aqui = Astro.url.pathname;
const alterna = parUrl ?? (lang === 'en' ? '/' : '/en/');
const temNotas = (await getCollection('notas')).length > 0;
const nav = [
  { texto: x.nav.sobre, href: raiz + '#sobre' },
  { texto: x.nav.exp, href: raiz + '#experiencia' },
  { texto: x.nav.skills, href: raiz + '#skills' },
  { texto: x.nav.casos, href: raiz + '#casos' },
  { texto: x.nav.contato, href: raiz + '#contato' },
];
---
<!doctype html>
<html lang={x.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="pt-BR" href={lang === 'pt' ? aqui : alterna} />
    <link rel="alternate" hreflang="en" href={lang === 'en' ? aqui : alterna} />
    <link rel="alternate" hreflang="x-default" href={lang === 'pt' ? aqui : alterna} />
    <meta property="og:image" content="/og.png" />
    <meta property="og:locale" content={x.lang} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "João Vitor Nogueira Xavier",
      "alternateName": "jnogxavier",
      "jobTitle": ["DevOps Engineer", "Platform Engineer", "Site Reliability Engineer", "Desenvolvedor Full Stack"],
      "description": "Engenheiro de plataforma e desenvolvedor full stack em Goiânia, Brasil.",
      "email": "mailto:jnogxavier@gmail.com",
      "address": { "@type": "PostalAddress", "addressLocality": "Goiânia", "addressRegion": "GO", "addressCountry": "BR" },
      "knowsAbout": ["DevOps", "Platform Engineering", "SRE", "Infraestrutura", "Kubernetes", "GitOps", "ArgoCD",
        "Terraform", "CI/CD", "Observabilidade", "OpenTelemetry", "Docker", "AWS", "Oracle Cloud",
        "Full Stack", "Ruby on Rails", "PostgreSQL", "React", "Flutter"],
      "knowsLanguage": ["pt-BR", "en"],
      "sameAs": ["https://github.com/jnogxavier", "https://linkedin.com/in/jnogxavier"],
      "url": "/"
    })} />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fontes/zilla-slab-700-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fontes/archivo-350_600-latin.woff2" />
  </head>
  <script is:inline>
    (() => {
      try {
        const t = localStorage.getItem('tema');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.tema = t;
      } catch (e) {}
    })();
  </script>
  <body>
    <a class="pular" href="#conteudo">{x.pular}</a>

    <header class="topo">
      <div class="tarja">
        <div class="faixa tarja__linha">
          <p class="estado">
            <span class="estado__no" aria-hidden="true"></span>
            <a href="mailto:jnogxavier@gmail.com" aria-label={x.statusLabel}>{x.status}</a>
            <span class="estado__onde">{x.onde}</span>
          </p>
        </div>
      </div>

      <div class="faixa topo__linha">
        <a class="marca" href={raiz} aria-label="Início" aria-current={atual === '/' ? 'page' : undefined}><Placa /></a>

        <nav class="menu" aria-label="Principal">
          {nav.map((l) => (
            <a href={l.href} aria-current={atual === l.href ? 'page' : undefined}>{l.texto}</a>
          ))}
          <a class="menu__cv" href={x.cvArquivo} download>{x.nav.cv}</a>
          <div class="idiomas" role="group" aria-label={lang === 'en' ? 'Language' : 'Idioma'}>
            {lang === 'pt'
              ? <span class="idioma idioma--atual" aria-current="true" lang="pt">Português</span>
              : <a class="idioma" href={alterna} hreflang="pt-BR" lang="pt">Português</a>}
            {lang === 'en'
              ? <span class="idioma idioma--atual" aria-current="true" lang="en">English</span>
              : <a class="idioma" href={alterna} hreflang="en" lang="en">English</a>}
          </div>
          <button class="tema" type="button" id="tema" aria-label={x.alternarTema}>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="tema__sol">
              <circle cx="12" cy="12" r="4.4" />
              <path d="M12 2.6v2.2M12 19.2v2.2M4.4 12H2.2M21.8 12h-2.2M6.6 6.6 5 5M19 19l-1.6-1.6M17.4 6.6 19 5M5 19l1.6-1.6" />
            </svg>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="tema__lua">
              <path d="M20 14.2A8.4 8.4 0 0 1 9.8 4 8.4 8.4 0 1 0 20 14.2Z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="conteudo" tabindex="-1"><slot /></main>

    <footer class="rodape">
      <div class="malha" aria-hidden="true"></div>
      <div class="faixa rodape__linha">
        <p class="rodape__nome">João Vitor Nogueira Xavier<span>Goiânia, Brasil</span></p>
        <nav class="rodape__links" aria-label="Contato">
          <a href="mailto:jnogxavier@gmail.com"><Icone nome="email" />jnogxavier@gmail.com</a>
          <a href="https://wa.me/5562983339111?text=Ol%C3%A1%2C%20Jo%C3%A3o%20Vitor.%20Vi%20seu%20portf%C3%B3lio%20e%20gostaria%20de%20conversar%20sobre%20uma%20oportunidade." target="_blank" rel="noopener noreferrer"><Icone nome="whatsapp" />WhatsApp</a>
          <a href="https://github.com/jnogxavier" target="_blank" rel="me noopener noreferrer"><Icone nome="github" />GitHub</a>
          <a href="https://linkedin.com/in/jnogxavier" target="_blank" rel="me noopener noreferrer"><Icone nome="linkedin" />LinkedIn</a>
          <a href={x.cvArquivo} download><Icone nome="download" />{x.nav.cv}</a>
          {lang === 'pt'
            ? <a href={alterna} hreflang="en" lang="en">English</a>
            : <a href={alterna} hreflang="pt-BR" lang="pt">Português</a>}
        </nav>
      </div>
    </footer>
    <script is:inline>
      document.getElementById('tema')?.addEventListener('click', () => {
        const raiz = document.documentElement;
        const escuroAgora = raiz.dataset.tema
          ? raiz.dataset.tema === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        const novo = escuroAgora ? 'light' : 'dark';
        raiz.dataset.tema = novo;
        try { localStorage.setItem('tema', novo); } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  :global(html) {
    margin: 0;
    scroll-padding-top: 7.5rem;
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
  :global(body) { margin: 0; }
  :global(section:target > .faixa > h2),
  :global(section:target > .faixa > .secao__cabeca > h2) {
    width: fit-content; max-width: 100%;
    animation: alvo 1600ms ease-out both;
  }
  @keyframes alvo {
    0%, 60% { box-shadow: inset 0 -0.42em 0 color-mix(in oklch, var(--measure) 32%, transparent); }
    100% { box-shadow: inset 0 -0.42em 0 transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(section:target > .faixa > h2),
    :global(section:target > .faixa > .secao__cabeca > h2) { animation: none; }
  }
  :global(:root) { --ease-out: cubic-bezier(0.23, 1, 0.32, 1); }
  :global(body) {
    background: var(--surface); color: var(--ink);
    font: 400 1rem/1.625 var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }
  .faixa, :global(.faixa) {
    max-width: 68rem; margin-inline: auto;
    padding-inline: max(var(--space-5), env(safe-area-inset-left), env(safe-area-inset-right));
  }
  :global(.malha) {
    position: absolute; inset: 0; pointer-events: none; opacity: 0.14;
    background-image:
      repeating-linear-gradient(to right, currentColor 0 1px, transparent 1px 32px),
      repeating-linear-gradient(to bottom, currentColor 0 1px, transparent 1px 32px);
  }

  .pular {
    position: absolute; left: var(--space-4); top: var(--space-4); z-index: 20;
    transform: translateY(-200%); transition: transform 160ms var(--ease-out);
    background: var(--band); color: var(--band-ink);
    padding: var(--space-3) var(--space-4); border-radius: var(--radius-sm);
    font: 500 0.9375rem/1 var(--font-sans); text-decoration: none;
  }
  .pular:focus { transform: translateY(0); }
  :global(main:focus) { outline: none; }

  .topo { border-bottom: 1px solid var(--line); background: var(--surface); position: sticky; top: 0; z-index: 10; }
  .tarja { border-bottom: 1px solid var(--line); background: var(--surface-raised); }
  .tarja__linha { display: flex; align-items: center; min-height: 36px; }
  .topo__linha {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-3) var(--space-5); min-height: 60px; flex-wrap: wrap;
  }
  .estado {
    margin: 0; display: flex; align-items: center; gap: var(--space-2); min-width: 0;
    font: 400 0.8125rem/1 var(--font-sans); color: var(--ink);
  }
  .estado__no {
    width: 7px; height: 7px; border-radius: var(--radius-full);
    background: var(--healthy); flex: none; align-self: center;
  }
  .estado a { color: inherit; display: inline-flex; align-items: center; min-height: 36px; text-underline-offset: 3px; text-decoration-color: var(--line); }
  .estado a:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  @media (hover: hover) { .estado a:hover { text-decoration-color: currentColor; } }
  .estado__onde { color: var(--ink-muted); white-space: nowrap; margin-left: var(--space-2); }

  .menu__cv, .idiomas, .tema {
    display: inline-flex; align-items: center; justify-content: center;
    height: 40px; align-self: center; flex: none; position: relative;
    background: none; border: 1px solid var(--line); border-radius: var(--radius-sm);
    color: var(--ink-muted); cursor: pointer; text-decoration: none;
    font: 500 0.875rem/1 var(--font-sans);
    transition: color 140ms ease, border-color 140ms ease;
  }
  .menu__cv { padding-inline: var(--space-4); color: var(--ink-muted) !important; padding-block: 0 !important; }
  .tema { width: 40px; padding: 0; }

  .idiomas { padding: 0; overflow: hidden; }
  .idioma {
    display: inline-flex; align-items: center; height: 100%;
    padding-inline: var(--space-3); white-space: nowrap;
    font: 500 0.8125rem/1 var(--font-sans); color: var(--ink-muted) !important;
    text-decoration: none; transition: background-color 140ms ease, color 140ms ease;
  }
  .idioma + .idioma { border-inline-start: 1px solid var(--line); }
  .idioma--atual { background: var(--brand); color: var(--surface) !important; }

  .menu__cv::after, .tema::after { content: ''; position: absolute; inset: -2px; }
  @media (hover: hover) {
    .menu__cv:hover, .tema:hover { color: var(--ink) !important; border-color: var(--brand); }
    a.idioma:hover { background: var(--surface-raised); color: var(--ink) !important; }
  }
  .menu__cv:focus-visible, .tema:focus-visible, .idioma:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .tema svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; }
  .tema__lua { display: none; }
  :global(:root[data-tema='dark']) .tema__sol,
  :global(:root:not([data-tema='light'])) .tema__sol { display: none; }
  :global(:root[data-tema='dark']) .tema__lua,
  :global(:root:not([data-tema='light'])) .tema__lua { display: block; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-tema='dark'])) .tema__sol { display: block; }
    :global(:root:not([data-tema='dark'])) .tema__lua { display: none; }
  }
  .tema:active, .menu__cv:active { transform: scale(0.96); }
  .tema:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  @media (hover: hover) { .tema:hover { color: var(--ink); border-color: var(--brand); } }

  @media (max-width: 30rem) { .estado__onde { display: none; } }
  .marca { color: var(--ink); text-decoration: none; display: inline-flex; }
  .menu { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-5); min-width: 0; }
  @media (max-width: 56rem) {
    .menu { gap: var(--space-2) var(--space-4); }
    .menu a { padding-block: 0.9375rem; font-size: 0.875rem; }
    .topo__linha { padding-block: var(--space-2); }
  }
  .menu a {
    font: 500 0.9375rem/1 var(--font-sans); letter-spacing: 0.005em;
    color: var(--ink-muted); text-decoration: none; padding-block: 1.46875rem;
    transition: color 140ms ease;
  }
  @media (hover: hover) { .menu a:hover { color: var(--ink); } }
  .menu a[aria-current='page'] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--brand); }
  .marca:focus-visible, .menu a:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }

  .rodape { position: relative; overflow: hidden; margin-top: var(--space-9); background: var(--band); color: var(--band-ink); }
  .rodape > :not(.malha) { position: relative; }
  .rodape__linha {
    display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6);
    justify-content: space-between; align-items: baseline;
    padding-block: var(--space-5) calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
    font: 400 0.875rem/1.5 var(--font-sans);
  }
  .rodape__nome { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); }
  .rodape__nome span { opacity: 0.7; }
  .rodape__links { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
  .rodape__links a { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; }
  .rodape a { color: inherit; text-underline-offset: 3px; text-decoration-color: color-mix(in oklch, currentColor 45%, transparent); }
  @media (hover: hover) { .rodape a:hover { text-decoration-color: currentColor; } }
  .rodape a:focus-visible { outline: 2px solid var(--band-ink); outline-offset: 3px; }
</style>
