---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Malha from '../components/Malha.astro';

const casos = (await getCollection('casos')).sort((a, b) => a.data.ordem - b.data.ordem);
const [destaque, ...resto] = casos;
const d = destaque?.data;
---
<Base
  titulo="jnogxavier — plataforma e entrega contínua"
  descricao="Casos de plataforma e entrega contínua: o que foi declarado, o que foi observado, e o que mudou entre os dois."
  atual="/"
>
  {d && (
    <section class="placa">
      <Malha />
      <div class="faixa placa__grade">
        <div class="abertura">
          <h1>{d.titulo}</h1>
          <p class="onde">{d.meta}</p>
        </div>

        <div class="coluna coluna--declarado">
          <p class="rotulo">Declarado</p>
          <p class="afirmacao">{d.declarado}</p>
        </div>

        <div class="coluna coluna--observado">
          <p class="rotulo">Observado</p>
          <p class="afirmacao">{d.observado}</p>
          <p class="medida">
            <span class="medida__valor">{d.resultado?.antes?.split(' ')[0]}</span>
            <span class="medida__unidade">{d.resultado?.unidade}</span>
          </p>
        </div>

        <div class="desvio"><span>desvio</span></div>

        <div class="coluna coluna--reconciliado">
          <p class="rotulo">Reconciliado</p>
          <p class="afirmacao">{d.reconciliado}</p>
          <p class="medida medida--boa">
            <span class="medida__valor">{d.resultado?.valor}</span>
            <span class="medida__unidade">{d.resultado?.unidade}</span>
          </p>
        </div>

        <div class="remate">
          <a class="botao" href={`/casos/${destaque.id}`}>Ler o caso</a>
        </div>
      </div>
    </section>
  )}

  <section class="indice faixa">
    {resto.length > 0 ? (
      <ul>{resto.map((c) => (
        <li class="linha"><a href={`/casos/${c.id}`}>
          <span class="linha__medida">
            <b>{c.data.resultado?.valor}</b>
            {c.data.resultado?.unidade && <small>{c.data.resultado.unidade}</small>}
          </span>
          <span class="linha__corpo"><b>{c.data.titulo}</b><small>{c.data.chamada}</small></span>
          <span class="linha__onde">{c.data.meta}</span>
        </a></li>))}
      </ul>
    ) : (
      <p class="vazio">Mais casos entram aqui conforme eu escrevo.</p>
    )}
  </section>
</Base>

<style>
  /* O movimento único do site: as duas leituras chegam fora de registro e
     assentam. É a reconciliação acontecendo, não uma entrada decorativa.
     transform e opacity só; animação CSS porque a página ainda carrega fonte. */
  @keyframes assenta-de-cima { from { opacity: 0; transform: translateY(-14px); } }
  @keyframes assenta-de-baixo { from { opacity: 0; transform: translateY(14px); } }
  @keyframes revela { from { opacity: 0; } }

  .coluna--declarado { animation: assenta-de-cima 380ms var(--ease-out) both; }
  .coluna--observado { animation: assenta-de-baixo 380ms var(--ease-out) both; }
  .desvio { animation: revela 260ms var(--ease-out) 320ms both; }

  /* Menos movimento, não zero: a revelação fica, o deslocamento sai. */
  @media (prefers-reduced-motion: reduce) {
    .coluna--declarado, .coluna--observado { animation: revela 240ms var(--ease-out) both; }
    .desvio { animation-delay: 160ms; }
  }

  .placa { position: relative; overflow: hidden; background: var(--brand); color: var(--surface); }
  .placa__grade {
    position: relative; display: grid; gap: var(--space-5);
    padding-block: var(--space-8) var(--space-9);
  }
  .rotulo {
    margin: 0 0 var(--space-2); font: 500 0.75rem/1 var(--font-sans);
    letter-spacing: 0.1em; opacity: 0.7;
  }
  .coluna { min-width: 0; }
  .afirmacao { margin: 0; font-size: 1.0625rem; line-height: 1.55; max-width: 42ch; }

  /* O numero e o elemento visual. O observado ruim fica apagado, o bom acende. */
  .medida { margin: var(--space-4) 0 0; display: flex; align-items: baseline; gap: var(--space-2); flex-wrap: wrap; }
  .medida__valor {
    font: 700 clamp(3rem, 1rem + 7vw, 5.5rem)/0.85 var(--font-display);
    letter-spacing: -0.04em; font-variant-numeric: tabular-nums;
    color: transparent; -webkit-text-stroke: 2px var(--surface);
  }
  @supports not (-webkit-text-stroke: 1px red) {
    .medida__valor { color: currentColor; opacity: 0.6; }
  }
  .medida--boa .medida__valor { color: var(--measure); -webkit-text-stroke: 0; }
  .medida__unidade { font: 400 0.875rem/1.3 var(--font-sans); opacity: 0.8; }

  /* O desvio e a informacao, nao enfeite: a linha que separa as duas leituras. */
  .desvio { display: flex; align-items: center; gap: var(--space-4); opacity: 0.75; }
  .desvio::before, .desvio::after { content: ''; height: 1px; background: currentColor; flex: 1; }
  .desvio span { font: 500 0.75rem/1 var(--font-sans); letter-spacing: 0.1em; flex: none; }

  .abertura { display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-3); }
  .remate { display: flex; }
  h1 { margin: 0; max-width: 24ch; font: 700 clamp(1.75rem, 1rem + 2.4vw, 2.5rem)/1.1 var(--font-display); letter-spacing: -0.018em; text-wrap: balance; }
  .onde { margin: 0; font-size: 0.875rem; opacity: 0.75; }
  .botao {
    display: inline-flex; align-items: center; min-height: 44px; padding-inline: var(--space-5);
    margin-top: var(--space-2); font: 500 0.9375rem/1 var(--font-sans); text-decoration: none;
    background: var(--surface); color: var(--brand-ink); border: 1.5px solid var(--surface);
  }
  .botao:focus-visible { outline: 2px solid var(--surface); outline-offset: 3px; }
  @media (hover: hover) { .botao:hover { opacity: 0.88; } }

  /* Em tela larga as duas leituras ficam lado a lado e o desvio corta entre elas. */
  @media (min-width: 56rem) {
    .placa__grade {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-7); row-gap: var(--space-6);
      grid-template-areas: "abe abe" "dec obs" "des des" "rec rem";
      align-items: start;
    }
    .abertura { grid-area: abe; }
    .remate { grid-area: rem; justify-self: start; align-self: end; }
    .coluna--declarado { grid-area: dec; }
    .coluna--observado { grid-area: obs; }
    .desvio { grid-area: des; }
    .coluna--reconciliado { grid-area: rec; }
  }

  .indice { padding-block: var(--space-5) 0; }
  .indice ul { list-style: none; margin: 0; padding: 0; }
  .linha { border-bottom: 1px solid var(--line); }
  .linha a { display: grid; gap: var(--space-2) var(--space-5); align-items: baseline; padding-block: var(--space-5); color: inherit; text-decoration: none; }
  /* Número sem unidade é ruído. Os dois andam juntos, sempre. */
  .linha__medida { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .linha__medida b { font: 700 1.75rem/1 var(--font-display); color: var(--measure-ink); font-variant-numeric: tabular-nums; }
  .linha__medida small { font: 400 0.75rem/1.3 var(--font-sans); color: var(--ink-muted); }
  .linha__corpo { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
  .linha__corpo b { font: 600 1.125rem/1.3 var(--font-sans); }
  .linha__corpo small { font: 400 0.9375rem/1.5 var(--font-sans); color: var(--ink-muted); }
  .linha__onde { font-size: 0.75rem; color: var(--ink-muted); }
  @media (min-width: 52rem) { .linha a { grid-template-columns: 9rem minmax(0, 1fr) 11rem; } .linha__onde { text-align: right; } }
  .vazio { color: var(--ink-muted); padding-block: var(--space-4); margin: 0; font-size: 0.9375rem; }
</style>
