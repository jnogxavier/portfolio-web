---
import { dg } from '../../data/diagramas';
import type { Idioma } from '../../i18n';
interface Props { lang?: Idioma }
const { lang = 'pt' } = Astro.props;
const d = dg.topologia[lang];
// Uma afirmação: existe uma porta só para fora, e as redes dos produtos não se
// falam diretamente — o tráfego entre elas sobe para a camada de aplicação.
// Versão abstrata de propósito: sem nome de recurso, sem faixa de endereço.
---
<figure class="dg">
  <svg viewBox="0 0 620 430" role="img"
       aria-label={d.alt}>
    <defs>
      <marker id="tp-ponta" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
      </marker>
    </defs>

    <text x="310" y="12" class="dg-nota">{d.ext}</text>
    <g class="dg-seta" marker-end="url(#tp-ponta)"><path d="M310 20 V40" /></g>

    <g class="dg-linha">
      <rect x="205" y="44" width="210" height="50" rx="2" class="dg-marcado" />
      <text x="310" y="66" class="dg-rot">{d.borda}</text>
      <text x="310" y="83" class="dg-nota-in">{d.bordaN}</text>

      <rect x="205" y="130" width="210" height="40" rx="2" />
      <text x="310" y="155" class="dg-rot">{d.rot}</text>
    </g>
    <g class="dg-seta" marker-end="url(#tp-ponta)">
      <path d="M310 94 V126" />
      <path d="M310 170 V194 H120 V218" />
      <path d="M310 170 V194 H500 V218" />
    </g>
    <text x="326" y="192" class="dg-aresta dg-aresta--lado">{d.porta}</text>

    <g class="dg-linha">
      <rect x="20" y="220" width="200" height="110" rx="2" />
      <text x="120" y="242" class="dg-rot">{d.prodA}</text>
      <rect x="48" y="256" width="144" height="56" rx="2" />
      <text x="120" y="278" class="dg-rot">{d.cluster}</text>
      <text x="120" y="296" class="dg-nota-in">{d.semIp}</text>

      <rect x="400" y="220" width="200" height="110" rx="2" />
      <text x="500" y="242" class="dg-rot">{d.prodB}</text>
      <rect x="428" y="256" width="144" height="56" rx="2" />
      <text x="500" y="278" class="dg-rot">{d.cluster}</text>
      <text x="500" y="296" class="dg-nota-in">{d.semIp}</text>

      <rect x="230" y="366" width="160" height="40" rx="2" />
      <text x="310" y="391" class="dg-rot">{d.gw}</text>
    </g>
    <g class="dg-seta dg-tracejada" marker-end="url(#tp-ponta)">
      <path d="M120 330 V386 H226" />
      <path d="M390 386 H500 V334" />
    </g>
    <text x="310" y="424" class="dg-aresta">{d.entre}</text>
  </svg>
  <figcaption>{d.cap}</figcaption>
</figure>

<style>
  .dg { margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .dg svg { width: 100%; height: auto; display: block; color: var(--ink); overflow: visible; }
  .dg-linha rect { fill: none; stroke: currentColor; stroke-width: 1.25; }
  .dg-marcado { stroke: var(--brand) !important; stroke-width: 1.75 !important; }
  .dg-seta path { fill: none; stroke: currentColor; stroke-width: 1.25; opacity: 0.75; }
  .dg-tracejada path { stroke-dasharray: 4 4; opacity: 0.5; }
  .dg-rot { fill: currentColor; font-family: var(--font-sans); font-size: 13px; font-weight: 500; text-anchor: middle; }
  .dg-nota-in { fill: currentColor; font-family: var(--font-sans); font-size: 11px; text-anchor: middle; opacity: 0.7; }
  .dg-nota { fill: currentColor; font-family: var(--font-sans); font-size: 11px; text-anchor: middle; opacity: 0.6; }
  .dg-aresta { fill: currentColor; font-family: var(--font-sans); font-size: 11px; text-anchor: middle; opacity: 0.7; }
  .dg-aresta--lado { text-anchor: start; }
  figcaption { font: 400 0.9375rem/1.5 var(--font-sans); color: var(--ink-muted); max-width: 62ch; }
</style>
