---
import Ponta from './Ponta.astro';
interface Props { d: any }
const { d } = Astro.props;
---
<figure class="dg">
  <div class="dg__rolagem">
    <svg viewBox="0 0 620 372" role="img"
         aria-label={d.alt}>
      <Ponta />

      <text x="0" y="14" class="dg-fase">{d.antes}</text>
      <g class="dg-linha">
        <rect x="0" y="34" width="92" height="30" rx="2" /><text x="46" y="53" class="dg-rot">{d.svcA}</text>
        <rect x="0" y="76" width="92" height="30" rx="2" /><text x="46" y="95" class="dg-rot">{d.svcB}</text>
        <rect x="0" y="118" width="92" height="30" rx="2" /><text x="46" y="137" class="dg-rot">{d.svcC}</text>

        <rect x="210" y="34" width="118" height="30" rx="2" /><text x="269" y="53" class="dg-rot">{d.pipeA}</text>
        <rect x="210" y="76" width="118" height="30" rx="2" /><text x="269" y="95" class="dg-rot">{d.pipeB}</text>
        <rect x="210" y="118" width="118" height="30" rx="2" /><text x="269" y="137" class="dg-rot">{d.pipeC}</text>

        <rect x="446" y="76" width="118" height="30" rx="2" /><text x="505" y="95" class="dg-rot">{d.prod}</text>
      </g>
      <g class="dg-seta" marker-end="url(#ponta)">
        <path d="M92 49 H204" /><path d="M92 91 H204" /><path d="M92 133 H204" />
        <path d="M328 49 H400 V88 H440" /><path d="M328 91 H440" /><path d="M328 133 H400 V94 H440" />
      </g>
      <text x="269" y="166" class="dg-nota">{d.nota}</text>

      <line x1="0" y1="196" x2="620" y2="196" class="dg-regua" />

      <text x="0" y="226" class="dg-fase">{d.depois}</text>
      <g class="dg-linha">
        <rect x="0" y="246" width="92" height="30" rx="2" /><text x="46" y="265" class="dg-rot">{d.svcA}</text>
        <rect x="0" y="288" width="92" height="30" rx="2" /><text x="46" y="307" class="dg-rot">{d.svcB}</text>
          <rect x="0" y="330" width="92" height="30" rx="2" /><text x="46" y="349" class="dg-rot">{d.svcC}</text>

        <rect x="210" y="279" width="118" height="48" rx="2" class="dg-marcado" />
        <text x="269" y="299" class="dg-rot">{d.tpl}</text>
        <text x="269" y="316" class="dg-nota-in">{d.cache}</text>

        <rect x="446" y="288" width="118" height="30" rx="2" /><text x="505" y="307" class="dg-rot">{d.prod}</text>
      </g>
      <g class="dg-seta" marker-end="url(#ponta)">
          <path d="M92 261 H170 V300 H204" /><path d="M92 303 H204" /><path d="M92 345 H170 V306 H204" />
          <path d="M328 303 H440" />
      </g>
    </svg>
  </div>
  <figcaption>{d.cap}</figcaption>
</figure>

<style>
  .dg-nota { fill: currentColor; font-family: var(--font-sans); font-size: 12px; text-anchor: middle; opacity: 0.7; }
  .dg-fase { fill: currentColor; font-family: var(--font-sans); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; opacity: 0.7; }
  .dg-regua { stroke: var(--line); stroke-width: 1; }
</style>
