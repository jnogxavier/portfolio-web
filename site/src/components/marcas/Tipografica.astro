---
interface Props { tamanho?: 'barra' | 'capa' }
const { tamanho = 'barra' } = Astro.props;
---
<span class:list={['placa', tamanho]}>
  <span class="placa__nome">jnogxavier</span>
</span>

<style>
  .placa {
    display: inline-flex; flex-direction: column; align-items: flex-start;
    border: 1.5px solid currentColor; color: currentColor;
  }
  .placa__nome {
    font-family: var(--font-display); font-weight: 700;
    letter-spacing: -0.02em; line-height: 1;
  }

  .barra { border-width: 1.25px; }
  .barra .placa__nome { font-size: 1.0625rem; padding: 0.3125rem 0.5rem 0.375rem; }

  .capa .placa__nome { font-size: clamp(1.75rem, 1rem + 3vw, 2.75rem); padding: 0.35em 0.42em 0.4em; }
</style>
