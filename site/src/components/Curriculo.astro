---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import Icone from './Icone.astro';
import Trajetoria from './Trajetoria.astro';
import Competencias from './Competencias.astro';
import { textos, type Idioma } from '../i18n';

interface Props { lang: Idioma; linha: any[]; par: string }
const { lang, linha, par } = Astro.props;
const rotulos = textos[lang];
const kb = Math.round(statSync(join(process.cwd(), 'public', rotulos.cvArquivo)).size / 1024);
---
<Base titulo={rotulos.cvTitulo} descricao={rotulos.cvDescricao} lang={lang} parUrl={par}>
  <article class="faixa cv">
    <header class="cv__cabeca">
      <h1>{rotulos.cvH1}</h1>
      <p class="cv__nota">{rotulos.cvNota}</p>
      <p class="cv__acao">
        <a class="jnx-acao jnx-acao--solido" href={rotulos.cvArquivo} download><Icone nome="download" />{rotulos.cvBaixar}</a>
        <span class="cv__meta">PDF, {kb} KB</span>
      </p>
    </header>
    <section class="cv__bloco">
      <h2>{rotulos.tExp}</h2>
      <Trajetoria linha={linha} />
    </section>
    <section class="cv__bloco">
      <h2>{rotulos.tSkills}</h2>
      <Competencias lang={lang} />
    </section>
  </article>
</Base>

<style>
  .cv { padding-block: var(--space-7) var(--space-9); display: flex; flex-direction: column; gap: var(--space-8); }
  .cv__cabeca { display: flex; flex-direction: column; gap: var(--space-4); align-items: flex-start; }
  h1 { margin: 0; font: 700 clamp(2rem, 1rem + 3.4vw, 3.5rem)/1.08 var(--font-display); letter-spacing: -0.022em; }
  .cv__nota { margin: 0; max-width: 56ch; color: var(--ink-muted); }
  .cv__acao { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-4); margin: 0; }
  .cv__meta { font: 400 0.75rem/1.4 var(--font-mono); color: var(--ink-muted); }
  .cv__bloco h2 { margin: 0 0 var(--space-5); font: 700 2rem/1.2 var(--font-display); letter-spacing: -0.015em; }
  .cv :global(.ic) { width: 1.125rem; height: 1.125rem; }
</style>
