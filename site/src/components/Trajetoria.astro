---
interface Props { linha: any[] }
const { linha } = Astro.props;
const marca = (t: string) => t.replace(/\*\*(.+?)\*\*/g, '<strong class="num">$1</strong>');
---
<ol class="trilha">
  {linha.map((e) => (
    <li>
      <div class="trilha__quando">
        <span class="trilha__periodo">{e.periodo}</span>
        <span class="trilha__lugar">{e.lugar}</span>
      </div>
      <div class="trilha__oque">
        <h3>{e.cargo}</h3>
        <p class="trilha__onde">{e.onde}</p>
        <ul class="trilha__itens">
          {e.texto.map((item) => <li set:html={marca(item)} />)}
        </ul>
      </div>
    </li>
  ))}
</ol>

<style>
  .trilha { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .trilha > li { padding-block: var(--space-5); border-top: 1px solid var(--line); display: grid; gap: var(--space-2); }
  .trilha > li:first-child { border-top: none; padding-top: 0; }
  .trilha__quando { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); }
  .trilha__periodo { font: 500 0.75rem/1.4 var(--font-mono); color: var(--ink); font-variant-numeric: tabular-nums; }
  .trilha__lugar { font: 400 0.75rem/1.4 var(--font-mono); color: var(--ink-muted); }
  .trilha__oque { display: flex; flex-direction: column; gap: var(--space-2); max-width: 66ch; min-width: 0; }
  .trilha h3 { margin: 0; font: 700 1.25rem/1.25 var(--font-display); letter-spacing: -0.01em; text-wrap: balance; }
  .trilha__onde { margin: 0; font: 500 1rem/1.4 var(--font-sans); color: var(--brand-ink); }
  .trilha__itens { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: var(--space-2); }
  .trilha__itens li { position: relative; padding-left: var(--space-4); color: var(--ink-muted); }
  .trilha__itens li::before { content: ""; position: absolute; left: 0; top: 0.8em; width: 6px; height: 1px; background: var(--ink-muted); }
  .trilha__itens :global(.num) { font: 600 0.9em var(--font-mono); color: var(--brand-ink); white-space: nowrap; }
  @media (min-width: 52rem) {
    .trilha > li { grid-template-columns: 13rem minmax(0, 1fr); gap: var(--space-5); }
  }
</style>
