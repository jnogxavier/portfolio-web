---
import { textos, type Idioma } from '../i18n';
import { dg } from '../data/diagramas';
import Esteira from './diagramas/Esteira.astro';
import Reconciliacao from './diagramas/Reconciliacao.astro';
import Correlacao from './diagramas/Correlacao.astro';
import TresFontes from './diagramas/TresFontes.astro';

const diagramas = { esteira: Esteira, reconciliacao: Reconciliacao, correlacao: Correlacao, tresfontes: TresFontes };

interface Props {
  titulo: string; meta: string;
  restricao: string; decisao: string; tradeoff?: string;
  chamada: string;
  declarado: string; observado: string; reconciliado: string;
  resultado?: { antes?: string; valor: string; unidade?: string };
  diagrama?: 'esteira' | 'reconciliacao' | 'correlacao' | 'tresfontes';
  ganhos?: string[];
  ant?: { id: string; titulo: string };
  prox?: { id: string; titulo: string };
  lang?: Idioma;
  aprendizado: string;
}
const { titulo, meta, chamada, restricao, decisao, tradeoff, declarado, observado, reconciliado, resultado, diagrama, ganhos = [], aprendizado, ant, prox, lang = 'pt' } = Astro.props;
const rotulos = textos[lang];
const Diagrama = diagrama ? diagramas[diagrama] : null;
const antes = [
  { rotulo: rotulos.rDeveria, texto: declarado },
  { rotulo: rotulos.rAcontecia, texto: observado },
  { rotulo: rotulos.rRestricao, texto: restricao },
  { rotulo: rotulos.rDecisao, texto: decisao },
  { rotulo: rotulos.rComo, texto: reconciliado },
];
---
<article class="jnx-caso">
  <div class="jnx-caso__cabeca">
    <h1 class="jnx-caso__titulo">{titulo}</h1>
    <p class="jnx-caso__meta">{meta}</p>
  </div>

  <div class="jnx-caso__movimento jnx-caso__movimento--resultado">
    <h2 class="jnx-caso__rotulo">{rotulos.rResultado}</h2>
    <p class="jnx-caso__texto">{chamada}</p>
    {resultado && (
      <p class="jnx-caso__resultado">
        <span class="jnx-caso__medida">{resultado.valor}</span>
        <span class="jnx-caso__legenda">
          {resultado.unidade && <span class="jnx-caso__unidade">{resultado.unidade}</span>}
          {resultado.antes && <span class="jnx-caso__contexto">{rotulos.contra} {resultado.antes} {rotulos.antes}</span>}
        </span>
      </p>
    )}
  </div>

  {antes.map(({ rotulo, texto }) => (
    <div class="jnx-caso__movimento">
      <h2 class="jnx-caso__rotulo">{rotulo}</h2>
      <p class="jnx-caso__texto">{texto}</p>
    </div>
  ))}

  {Diagrama && diagrama && <Diagrama d={dg[diagrama][lang]} />}


  {ganhos.length > 0 && (
    <div class="jnx-caso__movimento">
      <h2 class="jnx-caso__rotulo">{rotulos.destravou}</h2>
      <ul class="ganhos">
        {ganhos.map((g) => <li>{g}</li>)}
      </ul>
    </div>
  )}

  {tradeoff && (
    <div class="jnx-caso__movimento">
      <h2 class="jnx-caso__rotulo">{rotulos.rTradeoff}</h2>
      <p class="jnx-caso__texto">{tradeoff}</p>
    </div>
  )}

  <div class="jnx-caso__movimento">
    <h2 class="jnx-caso__rotulo">{rotulos.faria}</h2>
    <p class="jnx-caso__texto">{aprendizado}</p>
  </div>

  {(ant || prox) && (
    <nav class="entre" aria-label={rotulos.entreCasos}>
      {ant && (
        <a href={`${rotulos.casosRota}/${ant.id}/`} rel="prev">
          <span class="entre__rotulo">{rotulos.anterior}</span>
          <span class="entre__titulo">{ant.titulo}</span>
        </a>
      )}
      {prox && (
        <a class="entre__prox" href={`${rotulos.casosRota}/${prox.id}/`} rel="next">
          <span class="entre__rotulo">{rotulos.proximo}</span>
          <span class="entre__titulo">{prox.titulo}</span>
        </a>
      )}
    </nav>
  )}
</article>

<style>
  .ganhos { list-style: none; margin: 0; padding: 0; max-width: 68ch; }
  .ganhos li { padding-block: var(--space-3); border-top: 1px solid var(--line); }
  .ganhos li:first-child { border-top: none; padding-top: 0; }

  .entre { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); padding-top: var(--space-6); border-top: 1px solid var(--line); }
  .entre a {
    display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; min-height: 44px;
    color: var(--brand-ink); text-decoration: none; overflow-wrap: anywhere;
    transition: transform 160ms var(--ease-out);
  }
  .entre__prox { grid-column: 2; text-align: end; }
  .entre__rotulo { font: 500 0.75rem/1.4167 var(--font-sans); color: var(--ink-muted); }
  .entre__titulo { font: 700 1.25rem/1.25 var(--font-display); letter-spacing: -0.01em; text-wrap: balance; }
  .entre a:active { transform: scale(0.97); }
  .entre a:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
  @media (hover: hover) and (pointer: fine) { .entre a:hover .entre__titulo { text-decoration: underline; text-underline-offset: 4px; } }
  @media (max-width: 40rem) {
    .entre { grid-template-columns: 1fr; }
    .entre__prox { grid-column: 1; text-align: start; }
  }
</style>
