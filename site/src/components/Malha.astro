<div class="malha" aria-hidden="true">
  <svg viewBox="0 0 960 540" preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <pattern id="declarado" width="60" height="60" patternUnits="userSpaceOnUse">
        <path d="M60 0 H0 V60" fill="none" stroke="currentColor" stroke-width="1" />
        <circle cx="0" cy="0" r="2" fill="currentColor" />
      </pattern>
    </defs>
    <rect width="960" height="540" fill="url(#declarado)" opacity="0.26" />

    <g class="observado" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M120 67 L240 54 L243 180 L360 174" />
      <path d="M543 118 L548 243 L665 236 L672 362" />
      <path d="M186 303 L300 311 L305 424" />
      <path d="M728 66 L842 76 L845 192" />
      <path d="M420 421 L536 414 L540 300" />
    </g>
    <g class="observado-nos" fill="currentColor">
      <circle cx="240" cy="54" r="3.5" /><circle cx="243" cy="180" r="3.5" />
      <circle cx="548" cy="243" r="3.5" /><circle cx="665" cy="236" r="3.5" />
      <circle cx="300" cy="311" r="3.5" /><circle cx="842" cy="76" r="3.5" />
      <circle cx="536" cy="414" r="3.5" /><circle cx="672" cy="362" r="3.5" />
    </g>
  </svg>
</div>

<style>
  .malha { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .malha svg { width: 100%; height: 100%; display: block; }
  .observado, .observado-nos { opacity: 0.5; }
</style>
