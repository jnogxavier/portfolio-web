---
import Base from '../layouts/Base.astro';
import Icone from './Icone.astro';
import { skills, areasEn, itensEn } from '../data/skills';
import { textos, type Idioma } from '../i18n';
import { contato } from '../data/contato';

interface Props {
  lang: Idioma;
  seo: { titulo: string; descricao: string };
  casos: { id: string; data: any }[];
  linha: any[];
  sobre: string[];
}
const { lang, seo, casos, linha, sobre } = Astro.props;
const rotulos = textos[lang];
---
<Base
  titulo={seo.titulo}
  descricao={seo.descricao}
  lang={lang}
>
  <section class="capa" id="topo">
    <div class="faixa capa__grade">
      <div class="capa__texto">
        <p class="capa__nome">João Vitor Nogueira Xavier</p>
        <h1>{rotulos.h1}</h1>
        <p class="lede">{rotulos.lede}</p>
        <p class="capa__acoes">
          <a class="jnx-acao" href="#casos">{rotulos.verCasos}</a>
          <a class="jnx-acao jnx-acao--secundaria" href={contato.zap}
             target="_blank" rel="noopener noreferrer">{rotulos.zap}</a>
        </p>
      </div>
      <img class="capa__retrato" src="/retrato-capa.webp" width="512" height="640"
           alt={rotulos.fotoAlt} fetchpriority="high" decoding="async" />
    </div>
  </section>

  <section class="secao" id="sobre">
    <div class="faixa">
      <h2>{rotulos.tSobre}</h2>
      <div class="sobre__texto">{sobre.map((p) => <div class="sobre__bloco"><p>{p}</p></div>)}</div>
    </div>
  </section>

  <section class="secao secao--alt" id="experiencia">
    <div class="faixa">
      <h2>{rotulos.tExp}</h2>
      <ol class="trilha">
        {linha.map((e) => (
          <li>
            <div class="trilha__quando">
              <span class="trilha__periodo">{e.periodo}</span>
              <span class="trilha__lugar">{e.lugar}</span>
            </div>
            <div class="trilha__oque">
              <h3>{e.cargo}</h3>
              <p class="trilha__onde">{e.onde}</p>
              {e.texto.map((paragrafo) => <p>{paragrafo}</p>)}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="secao" id="skills">
    <div class="faixa">
      <h2>{rotulos.tSkills}</h2>
      <p class="skills__intro">{rotulos.skillsNota}</p>
      <dl class="skills">
        {skills.map((g) => (
          <div class="skills__linha">
            <dt>{lang === "en" ? areasEn[g.area] ?? g.area : g.area}</dt>
            <dd translate="no">{g.itens.map((i) => <span>{lang === "en" ? itensEn[i] ?? i : i}</span>)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="secao secao--alt" id="casos">
    <div class="faixa">
      <div class="secao__cabeca">
        <h2>{rotulos.tCasos}</h2>
        <p class="secao__nota">{rotulos.casosNota}</p>
      </div>
      <ol class="lista">
        {casos.map((c) => (
          <li>
            <a href={lang === "en" ? `/en/casos/${c.id}` : `/casos/${c.id}`}>
              <div class="lista__texto">
                <h3>{c.data.titulo}</h3>
                <p>{c.data.chamada}</p>
                <span class="lista__onde">{c.data.meta}</span>
              </div>
              <svg class="lista__seta" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M5 12h13M12.5 5.5 19 12l-6.5 6.5" fill="none" stroke="currentColor"
                      stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="secao" id="contato">
    <div class="faixa">
      <h2>{rotulos.tContato}</h2>
      <p class="contato__nota">{rotulos.contatoNota}</p>
      <nav class="canais" aria-label={rotulos.canais}>
        <a href={`mailto:${contato.email}`}><Icone nome="email" />{contato.email}</a>
        <a href={contato.zap} target="_blank" rel="noopener noreferrer"><Icone nome="whatsapp" />WhatsApp</a>
        <a href={contato.github} target="_blank" rel="me noopener noreferrer"><Icone nome="github" />GitHub</a>
        <a href={contato.linkedin} target="_blank" rel="me noopener noreferrer"><Icone nome="linkedin" />LinkedIn</a>
      </nav>
    </div>
  </section>
</Base>

<style>
  .capa { position: relative; overflow: hidden; background: var(--band); color: var(--band-ink); }
  .capa__grade {
    position: relative; padding-block: var(--space-8) var(--space-7);
    display: grid; gap: var(--space-6); align-items: center;
  }
  .capa__texto { display: flex; flex-direction: column; gap: var(--space-4); align-items: flex-start; min-width: 0; }
  .capa__retrato {
    width: 100%; max-width: 300px; height: auto; aspect-ratio: 4 / 5;
    object-fit: cover; justify-self: start;
    border: 1px solid color-mix(in oklch, var(--band-ink) 28%, transparent);
    border-radius: var(--radius-lg);
  }
  @media (min-width: 56rem) {
    .capa__grade { grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-8); }
    .capa__retrato { max-width: 340px; justify-self: end; }
  }
  .capa__nome { margin: 0; font: 500 0.9375rem/1.3 var(--font-sans); opacity: 0.8; }
  h1 {
    margin: 0; max-width: 18ch;
    font: 700 clamp(2rem, 1rem + 3.4vw, 3rem)/1.08 var(--font-display);
    letter-spacing: -0.022em; text-wrap: balance;
  }
  .lede { margin: 0; max-width: 56ch; font-size: 1.0625rem; opacity: 0.92; }
  .capa__acoes { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-2) 0 0; }

  .secao { padding-block: var(--space-8); }
  .secao--alt { background: var(--surface-raised); border-block: 1px solid var(--line); }
  .secao h2 {
    margin: 0 0 var(--space-5); font: 700 1.75rem/1.2 var(--font-display);
    letter-spacing: -0.015em;
  }
  .secao__cabeca { margin-bottom: var(--space-5); }
  .secao__cabeca h2 { margin-bottom: var(--space-2); }
  .secao__nota { margin: 0; color: var(--ink-muted); max-width: 62ch; }


  .capa__nome, .capa h1, .lede, .capa__acoes {
    transform: none;
    transition: opacity 480ms var(--ease-out), transform 480ms var(--ease-out);
  }
  .capa h1 { transition-delay: 70ms; }
  .lede { transition-delay: 140ms; }
  .capa__acoes { transition-delay: 210ms; }
  @starting-style {
    .capa__nome, .capa h1, .lede, .capa__acoes { opacity: 0; transform: translateY(14px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .capa__nome, .capa h1, .lede, .capa__acoes {
      transition: opacity 220ms linear; transition-delay: 0ms; transform: none !important;
    }
  }
  .sobre__texto { display: flex; flex-direction: column; min-width: 0; }
  .sobre__bloco { padding-block: var(--space-4); border-top: 1px solid var(--line); }
  .sobre__bloco:first-child { border-top: none; padding-top: 0; }
  .sobre__bloco p { margin: 0; max-width: 66ch; }

  .trilha { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .trilha li { padding-block: var(--space-5); border-top: 1px solid var(--line); display: grid; gap: var(--space-2); }
  .trilha li:first-child { border-top: none; padding-top: 0; }
  .trilha__quando { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); }
  .trilha__periodo { font: 500 0.875rem/1.4 var(--font-sans); color: var(--ink); font-variant-numeric: tabular-nums; }
  .trilha__lugar { font: 400 0.875rem/1.4 var(--font-sans); color: var(--ink-muted); }
  .trilha__oque { display: flex; flex-direction: column; gap: var(--space-2); max-width: 66ch; min-width: 0; }
  .trilha h3 { margin: 0; font: 700 1.25rem/1.25 var(--font-display); letter-spacing: -0.01em; }
  .trilha__onde { margin: 0; font: 500 0.9375rem/1.4 var(--font-sans); color: var(--brand-ink); }
  .trilha__oque p { margin: 0; color: var(--ink-muted); }
  .trilha__oque p.trilha__onde { color: var(--brand-ink); }
  @media (min-width: 52rem) {
    .trilha li { grid-template-columns: 13rem minmax(0, 1fr); gap: var(--space-5); }
  }

  .skills { margin: 0; }
  .skills__linha { display: grid; gap: var(--space-2); padding-block: var(--space-4); border-top: 1px solid var(--line); }
  .skills__linha:first-child { border-top: none; padding-top: 0; }
  .skills dt { font: 600 0.9375rem/1.4 var(--font-sans); color: var(--ink); }
  .skills dd { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) 0; min-width: 0; }
  .skills dd span {
    font: 400 0.9375rem/1.5 var(--font-sans); color: var(--ink-muted); white-space: nowrap;
    padding-inline: var(--space-3);
  }
  .skills dd span:first-child { padding-inline-start: 0; }
  .skills dd span:not(:last-child) { border-inline-end: 1px solid var(--line); }
  @media (min-width: 46rem) {
    .skills__linha { grid-template-columns: 15rem minmax(0, 1fr); gap: var(--space-5); align-items: baseline; }
  }

  .lista { list-style: none; margin: 0; padding: 0; }
  .lista li { border-top: 1px solid var(--line); }
  .lista li:first-child { border-top: none; }
  .lista a {
    display: grid; grid-template-columns: 1fr auto; align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-5);
    padding-inline: var(--space-3);
    margin-inline: calc(var(--space-3) * -1);
    border-radius: var(--radius-sm);
    color: inherit; text-decoration: none;
    transition: background-color 160ms ease;
  }
  .lista__texto { min-width: 0; }
  .lista__seta {
    width: 1.375rem; height: 1.375rem; color: var(--ink-muted);
    transition: transform 180ms var(--ease-out), color 160ms ease;
  }
  .lista h3 { margin: 0 0 var(--space-2); font: 700 1.25rem/1.25 var(--font-display); letter-spacing: -0.01em; }
  .lista p { margin: 0 0 var(--space-2); color: var(--ink-muted); max-width: 64ch; }
  .lista__onde { font-size: 0.75rem; color: var(--ink-muted); }
  @media (hover: hover) and (pointer: fine) {
    .lista a:hover { background: color-mix(in oklch, var(--brand) 7%, transparent); }
    .lista a:hover h3 { text-decoration: underline; text-underline-offset: 4px; }
    .lista a:hover .lista__seta { transform: translateX(5px); color: var(--brand-ink); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lista__seta { transition: color 160ms ease; }
    .lista a:hover .lista__seta { transform: none; }
  }
  .lista a:active { background: var(--line); transition-duration: 0ms; }
  .lista a:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }

  .skills__intro { margin: -0.5rem 0 var(--space-5); color: var(--ink-muted); max-width: 62ch; }
  .contato__nota { margin: 0 0 var(--space-5); max-width: 62ch; color: var(--ink-muted); }
  .canais { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); }
  .canais a {
    display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: 44px; color: var(--brand-ink);
    font: 500 1rem/1 var(--font-sans); text-underline-offset: 4px;
  }
  .canais a:focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; }
</style>
