---
import Base from '../layouts/Base.astro';
import Icone from './Icone.astro';
import Trajetoria from './Trajetoria.astro';
import Competencias from './Competencias.astro';
import { textos, type Idioma } from '../i18n';
import { contato } from '../data/contato';

interface Props {
  lang: Idioma;
  seo: { titulo: string; descricao: string };
  casos: { id: string; data: any }[];
  linha: any[];
  sobre: { abertura: string; resto: string }[];
}
const { lang, seo, casos, linha, sobre } = Astro.props;
const rotulos = textos[lang];
---
<Base
  titulo={seo.titulo}
  descricao={seo.descricao}
  lang={lang}
  canais={false}
>
  <section class="capa" id="topo">
    <div class="faixa capa__grade">
      <div class="capa__texto">
        <p class="capa__nome">João Vitor Nogueira Xavier</p>
        <h1>{rotulos.h1}</h1>
        <p class="lede">{rotulos.lede}</p>
        <p class="capa__acoes">
          <a class="jnx-acao" href={`mailto:${contato.email}`}>{rotulos.email}</a>
          <a class="jnx-acao jnx-acao--secundaria" href={rotulos.cvArquivo} download><Icone nome="download" />{rotulos.cvBaixar}</a>
        </p>
      </div>
      <img class="capa__retrato" src="/retrato-capa.webp" width="512" height="640"
           alt={rotulos.fotoAlt} fetchpriority="high" decoding="async" />
    </div>
  </section>

  <section class="secao secao--alt" id="casos">
    <div class="faixa">
      <div class="secao__cabeca">
        <h2>{rotulos.tCasos}</h2>
        <p class="secao__nota">{rotulos.casosNota}</p>
      </div>
      <ol class="lista">
        {casos.map((c) => (
          <li>
            <a href={lang === "en" ? `/en/casos/${c.id}` : `/casos/${c.id}`}>
              <div class="lista__texto">
                <h3>{c.data.titulo}</h3>
                <p>{c.data.chamada}</p>
                <span class="lista__onde">{c.data.meta}</span>
              </div>
              <svg class="lista__seta" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M5 12h13M12.5 5.5 19 12l-6.5 6.5" fill="none" stroke="currentColor"
                      stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="secao" id="sobre">
    <div class="faixa">
      <h2>{rotulos.tSobre}</h2>
      <div class="sobre__texto">{sobre.map((p) => <div class="sobre__bloco"><p><strong class="sobre__lead">{p.abertura}</strong> {p.resto}</p></div>)}</div>
    </div>
  </section>

  <section class="secao secao--alt" id="experiencia">
    <div class="faixa">
      <div class="secao__cabeca">
        <h2>{rotulos.tExp}</h2>
        <p class="secao__nota">{rotulos.expNota}</p>
      </div>
      <Trajetoria linha={linha} />
    </div>
  </section>

  <section class="secao" id="skills">
    <div class="faixa">
      <h2>{rotulos.tSkills}</h2>
      <p class="skills__intro">{rotulos.skillsNota}</p>
      <Competencias lang={lang} />
    </div>
  </section>

  <section class="secao secao--banda" id="contato">
    <div class="faixa">
      <h2>{rotulos.tContato}</h2>
      <p class="contato__nota">{rotulos.contatoNota}</p>
      <a class="contato__email" href={`mailto:${contato.email}`} translate="no">{contato.email}</a>
      <nav class="canais" aria-label={rotulos.canais}>
        <a href={contato.zap} target="_blank" rel="noopener noreferrer"><Icone nome="whatsapp" />WhatsApp</a>
        <a href={contato.github} target="_blank" rel="me noopener noreferrer"><Icone nome="github" />GitHub</a>
        <a href={contato.linkedin} target="_blank" rel="me noopener noreferrer"><Icone nome="linkedin" />LinkedIn</a>
        <a href={rotulos.cvArquivo} download><Icone nome="download" />{rotulos.cvBaixar}</a>
      </nav>
    </div>
  </section>
</Base>

<style>
  .capa { position: relative; overflow: hidden; background: var(--band); color: var(--band-ink); }
  .capa__grade {
    position: relative; padding-block: var(--space-8) var(--space-7);
    display: grid; gap: var(--space-6); align-items: center;
  }
  .capa__texto { display: flex; flex-direction: column; gap: var(--space-4); align-items: flex-start; min-width: 0; }
  .capa__retrato {
    width: 100%; max-width: 300px; height: auto; aspect-ratio: 4 / 5;
    object-fit: cover; justify-self: start;
    border: 1px solid color-mix(in oklch, var(--band-ink) 28%, transparent);
    border-radius: var(--radius-lg);
  }
  @media (min-width: 56rem) {
    .capa__grade { grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-8); }
    .capa__retrato { max-width: 340px; justify-self: end; }
  }
  .capa__nome {
    margin: 0; font: 700 clamp(1.375rem, 1rem + 1.5vw, 2rem)/1.15 var(--font-display);
    letter-spacing: -0.015em; text-wrap: balance;
  }
  h1 {
    margin: 0; max-width: 18ch;
    font: 700 clamp(2rem, 1rem + 3.4vw, 3.5rem)/1.08 var(--font-display);
    letter-spacing: -0.022em; text-wrap: balance; overflow-wrap: anywhere;
  }
  .lede { margin: 0; max-width: 56ch; opacity: 0.92; }
  .capa__acoes { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-2) 0 0; }

  .secao { padding-block: var(--space-8); }
  .secao--alt { background: var(--surface-raised); border-block: 1px solid var(--line); }
  .secao h2 {
    margin: 0 0 var(--space-5); font: 700 2rem/1.2 var(--font-display);
    letter-spacing: -0.015em; text-wrap: balance;
  }
  .secao__cabeca { margin-bottom: var(--space-5); }
  .secao__cabeca h2 { margin-bottom: var(--space-2); }
  .secao__nota { margin: 0; color: var(--ink-muted); max-width: 62ch; }


  .capa__nome, .capa h1, .lede, .capa__acoes {
    transform: none;
    transition: opacity 360ms var(--ease-out), transform 360ms var(--ease-out);
  }
  .capa h1 { transition-delay: 50ms; }
  .lede { transition-delay: 100ms; }
  .capa__acoes { transition-delay: 150ms; }
  @starting-style {
    .capa__nome, .capa h1, .lede, .capa__acoes { opacity: 0; transform: translateY(14px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .capa__nome, .capa h1, .lede, .capa__acoes {
      transition: opacity 220ms var(--ease-out); transition-delay: 0ms; transform: none !important;
    }
  }
  .sobre__texto { display: flex; flex-direction: column; min-width: 0; }
  .sobre__bloco { padding-block: var(--space-4); border-top: 1px solid var(--line); }
  .sobre__bloco:first-child { border-top: none; padding-top: 0; }
  .sobre__bloco p { margin: 0; max-width: 66ch; }
  .sobre__lead { font-weight: 600; }


  .lista { list-style: none; margin: 0; padding: 0; }
  .lista li { border-top: 1px solid var(--line); }
  .lista li:first-child { border-top: none; }
  .lista a {
    display: grid; grid-template-columns: 1fr auto; align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-5);
    padding-inline: var(--space-3);
    margin-inline: calc(var(--space-3) * -1);
    border-radius: var(--radius-sm);
    color: inherit; text-decoration: none;
    transition: background-color 160ms ease;
  }
  .lista__texto { min-width: 0; }
  .lista__seta {
    width: 1.375rem; height: 1.375rem; color: var(--ink-muted);
    transition: transform 180ms var(--ease-out), color 160ms ease;
  }
  .lista h3 { margin: 0 0 var(--space-2); font: 700 1.25rem/1.25 var(--font-display); letter-spacing: -0.01em; text-wrap: balance; }
  .lista p { margin: 0 0 var(--space-2); color: var(--ink-muted); max-width: 64ch; }
  .lista__onde { font: 500 0.75rem/1.4 var(--font-mono); color: var(--brand-ink); }
  @media (hover: hover) and (pointer: fine) {
    .lista a:hover { background: color-mix(in oklch, var(--brand) 7%, transparent); }
    .lista a:hover h3 { text-decoration: underline; text-underline-offset: 4px; }
    .lista a:hover .lista__seta { transform: translateX(5px); color: var(--brand-ink); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lista__seta { transition: color 160ms ease; }
    .lista a:hover .lista__seta { transform: none; }
  }
  .lista a:active { background: var(--line); transition-duration: 0ms; }
  .lista a:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }

  .skills__intro { margin: -0.5rem 0 var(--space-5); color: var(--ink-muted); max-width: 62ch; }
  .secao--banda { background: var(--band); color: var(--band-ink); border-block: none; }
  .secao--banda h2 { color: inherit; }
  .contato__nota { margin: 0 0 var(--space-5); max-width: 62ch; opacity: 0.88; }
  .contato__email {
    display: flex; align-items: center; width: fit-content; min-height: 44px; margin-bottom: var(--space-2);
    font: 500 1.25rem/1.3 var(--font-sans);
    color: inherit; text-underline-offset: 4px; overflow-wrap: anywhere;
    transition: transform 160ms var(--ease-out);
  }
  .contato__email:focus-visible, .canais a:focus-visible { outline: 2px solid var(--band-ink); outline-offset: 3px; }
  .contato__email:active, .canais a:active { transform: scale(0.97); }
  .canais { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); }
  .canais a {
    display: inline-flex; align-items: center; gap: var(--space-2);
    min-height: 44px; color: inherit;
    font: 500 1rem/1 var(--font-sans); text-underline-offset: 4px; overflow-wrap: anywhere;
    transition: transform 160ms var(--ease-out);
  }
</style>
